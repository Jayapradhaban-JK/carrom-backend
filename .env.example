# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# For Cloud PostgreSQL (Render / Neon / Supabase):
DATABASE_URL=postgresql://carrom_user:password@host.render.com/carrom
DB_SSL=true

# Or Local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=carrom

# JWT Secret for Administrator Authentication
JWT_SECRET=your_jwt_secret_key_here

# Administrator Initial Setup Credentials
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# CORS Allowed Origins
CORS_ORIGIN=*

